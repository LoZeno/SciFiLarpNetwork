<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformCommandLineArguments>--coverlet --coverlet-file-prefix $(AssemblyName) --results-directory $(MSBuildProjectDirectory)/TestResults/coverage</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SciFiLarpNetwork.Management.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\Shared\SciFiLarpNetwork.ApiLinkPolicy\test-cases.json"
          Link="test-cases.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\appsettings.json"
          Link="appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="coverlet.mtp.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>