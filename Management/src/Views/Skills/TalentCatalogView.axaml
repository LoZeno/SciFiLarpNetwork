<UserControl
    x:Class="SciFiLarpNetwork.Management.Views.Skills.TalentCatalogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.Skills"
    x:DataType="vm:TalentCatalogViewModel">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*" ColumnSpacing="24" RowSpacing="12">
    <TextBlock
        Grid.Row="0"
        Grid.ColumnSpan="2"
        AutomationProperties.LiveSetting="Polite"
        IsVisible="{Binding HasStatusMessage}"
        Text="{Binding StatusMessage}"
        TextWrapping="Wrap" />
    <DockPanel Grid.Row="1" Grid.Column="0">
      <TextBlock
          DockPanel.Dock="Top"
          FontSize="20"
          FontWeight="SemiBold"
          Text="{Binding TalentsHeading}" />
      <CheckBox
          DockPanel.Dock="Top"
          Content="{Binding ShowArchivedLabel}"
          IsChecked="{Binding ShowArchivedTalents}" />
      <StackPanel
          Margin="0,8,0,0"
          DockPanel.Dock="Bottom"
          IsVisible="{Binding CanWrite}"
          Orientation="Horizontal"
          Spacing="8">
        <Button Command="{Binding NewTalentCommand}" Content="{Binding NewLabel}" />
        <Button Command="{Binding EditTalentCommand}" Content="{Binding EditLabel}" />
        <Button Command="{Binding ToggleTalentArchiveCommand}" Content="{Binding TalentArchiveLabel}" />
      </StackPanel>
      <TextBlock
          Margin="0,8"
          DockPanel.Dock="Top"
          IsVisible="{Binding HasTalentsPlaceholder}"
          Text="{Binding TalentsPlaceholder}"
          TextWrapping="Wrap" />
      <ListBox
          AutomationProperties.Name="{Binding TalentsHeading}"
          ItemsSource="{Binding Talents}"
          SelectedItem="{Binding SelectedTalent, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TalentListItem">
            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <DockPanel Grid.Row="1" Grid.Column="1">
      <TextBlock
          DockPanel.Dock="Top"
          FontSize="20"
          FontWeight="SemiBold"
          Text="{Binding SkillsHeading}" />
      <CheckBox
          DockPanel.Dock="Top"
          Content="{Binding ShowArchivedLabel}"
          IsChecked="{Binding ShowArchivedSkills}" />
      <StackPanel
          Margin="0,8,0,0"
          DockPanel.Dock="Bottom"
          IsVisible="{Binding CanWrite}"
          Orientation="Horizontal"
          Spacing="8">
        <Button Command="{Binding NewSkillCommand}" Content="{Binding NewLabel}" />
        <Button Command="{Binding EditSkillCommand}" Content="{Binding EditLabel}" />
        <Button Command="{Binding ToggleSkillArchiveCommand}" Content="{Binding SkillArchiveLabel}" />
      </StackPanel>
      <TextBlock
          Margin="0,8"
          DockPanel.Dock="Top"
          IsVisible="{Binding HasSkillsPlaceholder}"
          Text="{Binding SkillsPlaceholder}"
          TextWrapping="Wrap" />
      <ListBox
          AutomationProperties.Name="{Binding SkillsHeading}"
          ItemsSource="{Binding Skills}"
          SelectedItem="{Binding SelectedSkill, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SkillListItem">
            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
