<Window
    x:Class="SciFiLarpNetwork.Management.Views.Skills.TalentEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.Skills"
    x:DataType="vm:TalentEditorViewModel"
    Title="{Binding Title}"
    Width="520"
    CanResize="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="10">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
    <TextBlock Text="{Binding NameLabel}" />
    <TextBox
        AutomationProperties.Name="{Binding NameLabel}"
        MaxLength="64"
        Text="{Binding Name, Mode=TwoWay}" />
    <TextBlock Text="{Binding DescriptionLabel}" />
    <TextBox
        Height="120"
        AcceptsReturn="True"
        AutomationProperties.Name="{Binding DescriptionLabel}"
        MaxLength="2000"
        Text="{Binding Description, Mode=TwoWay}"
        TextWrapping="Wrap" />
    <TextBlock
        AutomationProperties.LiveSetting="Assertive"
        Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
        IsVisible="{Binding HasError}"
        Text="{Binding ErrorMessage}"
        TextWrapping="Wrap" />
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button
          Command="{Binding SaveCommand}"
          Content="{Binding SaveLabel}"
          IsDefault="True" />
      <Button
          Command="{Binding CancelCommand}"
          Content="{Binding CancelLabel}"
          IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
