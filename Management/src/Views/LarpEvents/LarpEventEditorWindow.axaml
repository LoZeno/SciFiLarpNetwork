<Window
    x:Class="SciFiLarpNetwork.Management.Views.LarpEvents.LarpEventEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SciFiLarpNetwork.Management.Views.Converters"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.LarpEvents"
    x:DataType="vm:LarpEventEditorViewModel"
    Title="{Binding Title}"
    Width="560"
    Height="460"
    MinWidth="420"
    MinHeight="360"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom" Spacing="10">
      <TextBlock
          AutomationProperties.LiveSetting="Assertive"
          Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
          IsVisible="{Binding HasError}"
          Text="{Binding ErrorMessage}"
          TextWrapping="Wrap" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding SaveCommand}" Content="{Binding SaveLabel}" IsDefault="True" />
        <Button Command="{Binding CancelCommand}" Content="{Binding CancelLabel}" IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <StackPanel Spacing="10">
      <TextBlock Classes="heading" Text="{Binding Title, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
      <TextBlock Text="{Binding EventNameLabel}" />
      <TextBox AutomationProperties.Name="{Binding EventNameLabel}" MaxLength="64" Text="{Binding Name, Mode=TwoWay}" />
      <TextBlock Text="{Binding EventDescriptionLabel}" />
      <TextBox
          Height="140"
          AcceptsReturn="True"
          AutomationProperties.Name="{Binding EventDescriptionLabel}"
          MaxLength="2000"
          Text="{Binding Description, Mode=TwoWay}"
          TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</Window>
