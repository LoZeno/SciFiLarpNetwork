<Window
    x:Class="SciFiLarpNetwork.Management.Views.LarpEvents.RegistrationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SciFiLarpNetwork.Management.Views.Converters"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.LarpEvents"
    x:DataType="vm:RegistrationEditorViewModel"
    Title="{Binding Title}"
    Width="560"
    Height="640"
    MinWidth="420"
    MinHeight="480"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom" Spacing="10">
      <TextBlock
          AutomationProperties.LiveSetting="Assertive"
          Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
          IsVisible="{Binding HasError}"
          Text="{Binding ErrorMessage}"
          TextWrapping="Wrap" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding SaveCommand}" Content="{Binding SaveLabel}" IsDefault="True" />
        <Button Command="{Binding CancelCommand}" Content="{Binding CancelLabel}" IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Classes="heading" Text="{Binding Title, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
      <TextBlock Text="{Binding CharacterLabel}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox
            Grid.Column="0"
            AutomationProperties.Name="{Binding SearchLabel}"
            PlaceholderText="{Binding SearchLabel}"
            Text="{Binding SearchText, Mode=TwoWay}">
          <TextBox.KeyBindings>
            <KeyBinding Command="{Binding SearchCommand}" Gesture="Enter" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="{Binding SearchButtonLabel}" />
      </Grid>
      <TextBlock IsVisible="{Binding HasSearchMessage}" Text="{Binding SearchMessage}" TextWrapping="Wrap" />
      <ListBox
          MaxHeight="180"
          AutomationProperties.Name="{Binding CharacterLabel}"
          ItemsSource="{Binding Characters}"
          SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CharacterChoice">
            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock IsVisible="{Binding HasAlreadyRegisteredText}" Text="{Binding AlreadyRegisteredText}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding DaysLabel}" />
        <Button Grid.Column="1" Command="{Binding SelectAllDaysCommand}" Content="{Binding AllDaysLabel}" />
      </Grid>
    </StackPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Days}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DayChoice">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
