<Window
    x:Class="SciFiLarpNetwork.Management.Views.News.NewsMediaLibraryWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SciFiLarpNetwork.Management.Views.Converters"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.News"
    x:DataType="vm:NewsMediaLibraryViewModel"
    Title="{Binding Title}"
    Width="980"
    Height="720"
    MinWidth="640"
    MinHeight="480"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom" Spacing="10">
      <TextBlock
          AutomationProperties.LiveSetting="Assertive"
          IsVisible="{Binding HasStatusMessage}"
          Text="{Binding StatusMessage}"
          TextWrapping="Wrap" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding ChooseCommand}" Content="{Binding ChooseLabel}" IsDefault="True" IsVisible="{Binding IsChoosing}" />
        <Button Command="{Binding CloseCommand}" Content="{Binding CloseLabel}" IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{Binding Title, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
    <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0" Text="{Binding LimitsText}" TextWrapping="Wrap" />
    <Grid
        Margin="0,8,0,0"
        DockPanel.Dock="Top"
        ColumnDefinitions="*,Auto"
        ColumnSpacing="8"
        IsVisible="{Binding CanWrite}">
      <TextBox
          Grid.Column="0"
          AutomationProperties.Name="{Binding UploadNameLabel}"
          MaxLength="{Binding MaximumNameLength}"
          PlaceholderText="{Binding UploadNameLabel}"
          Text="{Binding UploadName, Mode=TwoWay}" />
      <Button Grid.Column="1" Command="{Binding UploadCommand}" Content="{Binding UploadLabel}" />
    </Grid>
    <Grid Margin="0,10,0,0" ColumnDefinitions="*,*" ColumnSpacing="24">
      <DockPanel Grid.Column="0">
        <Button
            Margin="0,8,0,0"
            DockPanel.Dock="Bottom"
            Command="{Binding RemoveCommand}"
            Content="{Binding RemoveLabel}"
            IsVisible="{Binding CanWrite}" />
        <TextBlock DockPanel.Dock="Top" IsVisible="{Binding HasPlaceholder}" Text="{Binding Placeholder}" TextWrapping="Wrap" />
        <ListBox
            AutomationProperties.Name="{Binding Title}"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NewsMediaListItem">
              <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" />
          <Image
              MaxHeight="300"
              HorizontalAlignment="Left"
              AutomationProperties.Name="{Binding SelectedDescription}"
              IsVisible="{Binding IsSelectedPicture}"
              Source="{Binding SelectedPicture, Converter={x:Static conv:ImageBytesConverter.Instance}}"
              Stretch="Uniform" />
          <StackPanel IsVisible="{Binding IsSelectedVideo}" Orientation="Horizontal" Spacing="10">
            <TextBlock VerticalAlignment="Center" FontSize="28" Text="▶" />
            <TextBlock VerticalAlignment="Center" Text="{Binding VideoNote}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsChoosing}" Spacing="8">
            <TextBlock Text="{Binding MediaTextLabel}" />
            <TextBox AutomationProperties.Name="{Binding MediaTextLabel}" Text="{Binding MediaText, Mode=TwoWay}" />
            <StackPanel IsVisible="{Binding IsSelectedVideo}" Spacing="6">
              <CheckBox Content="{Binding AutoplayLabel}" IsChecked="{Binding Autoplay, Mode=TwoWay}" />
              <TextBlock Text="{Binding AutoplayNote}" TextWrapping="Wrap" />
              <CheckBox Content="{Binding LoopLabel}" IsChecked="{Binding Loop, Mode=TwoWay}" />
              <CheckBox Content="{Binding ControlsLabel}" IsChecked="{Binding Controls, Mode=TwoWay}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
