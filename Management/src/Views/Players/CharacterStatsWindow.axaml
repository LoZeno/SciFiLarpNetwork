<Window
    x:Class="SciFiLarpNetwork.Management.Views.Players.CharacterStatsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SciFiLarpNetwork.Management.Views.Converters"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.Players"
    x:DataType="vm:CharacterStatsViewModel"
    Title="{Binding Title}"
    Width="520"
    Height="600"
    MinWidth="400"
    MinHeight="400"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Classes="heading" Text="{Binding Title, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
      <TextBlock FontSize="12" Text="{Binding Help}" TextWrapping="Wrap" />
      <TextBlock
          AutomationProperties.LiveSetting="Polite"
          IsVisible="{Binding HasStatusMessage}"
          Text="{Binding StatusMessage}"
          TextWrapping="Wrap" />
      <CheckBox Content="{Binding ShowArchivedLabel}" IsChecked="{Binding ShowArchived}" />
    </StackPanel>
    <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom" Spacing="8">
      <StackPanel IsVisible="{Binding CanWrite}" Spacing="8">
        <TextBlock Text="{Binding NewNameLabel}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" AutomationProperties.Name="{Binding NewNameLabel}" MaxLength="64" Text="{Binding NewName, Mode=TwoWay}" />
          <Button Grid.Column="1" Command="{Binding RenameCommand}" Content="{Binding RenameLabel}" />
        </Grid>
        <Button Command="{Binding ToggleArchivedCommand}" Content="{Binding ToggleArchivedLabel}" />
      </StackPanel>
      <Button HorizontalAlignment="Right" Command="{Binding CloseCommand}" Content="{Binding CloseLabel}" IsCancel="True" />
    </StackPanel>
    <TextBlock
        Margin="0,8"
        DockPanel.Dock="Top"
        IsVisible="{Binding HasStatsPlaceholder}"
        Text="{Binding StatsPlaceholder}"
        TextWrapping="Wrap" />
    <ListBox
        Margin="0,8,0,0"
        AutomationProperties.Name="{Binding Title}"
        ItemsSource="{Binding Stats}"
        SelectedItem="{Binding SelectedStat, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CharacterStatListItem">
          <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
