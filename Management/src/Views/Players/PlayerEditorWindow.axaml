<Window
    x:Class="SciFiLarpNetwork.Management.Views.Players.PlayerEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.Players"
    x:DataType="vm:PlayerEditorViewModel"
    Title="{Binding Title}"
    Width="560"
    Height="620"
    MinWidth="420"
    MinHeight="420"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom" Spacing="10">
      <TextBlock
          AutomationProperties.LiveSetting="Assertive"
          Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
          IsVisible="{Binding HasError}"
          Text="{Binding ErrorMessage}"
          TextWrapping="Wrap" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding SaveCommand}" Content="{Binding SaveLabel}" IsDefault="True" />
        <Button Command="{Binding CancelCommand}" Content="{Binding CancelLabel}" IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Margin="0,0,12,0" Spacing="10">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Text="{Binding DisplayNameLabel}" />
        <TextBox AutomationProperties.Name="{Binding DisplayNameLabel}" MaxLength="64" Text="{Binding Name, Mode=TwoWay}" />
        <TextBlock Text="{Binding TypeLabel}" />
        <ComboBox
            MinWidth="200"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{Binding TypeLabel}"
            ItemsSource="{Binding Types}"
            SelectedItem="{Binding SelectedType, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RosterChoice">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding EmailLabel}" />
        <TextBox AutomationProperties.Name="{Binding EmailLabel}" MaxLength="254" Text="{Binding Email, Mode=TwoWay}" />
        <TextBlock Text="{Binding PhoneLabel}" />
        <TextBox AutomationProperties.Name="{Binding PhoneLabel}" MaxLength="32" Text="{Binding Phone, Mode=TwoWay}" />
        <TextBlock Text="{Binding NotesLabel}" />
        <TextBox
            Height="120"
            AcceptsReturn="True"
            AutomationProperties.Name="{Binding NotesLabel}"
            MaxLength="2000"
            Text="{Binding Description, Mode=TwoWay}"
            TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
