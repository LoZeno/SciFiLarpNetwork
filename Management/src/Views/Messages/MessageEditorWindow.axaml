<Window
    x:Class="SciFiLarpNetwork.Management.Views.Messages.MessageEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SciFiLarpNetwork.Management.Views.Converters"
    xmlns:events="using:SciFiLarpNetwork.Management.ViewModels.LarpEvents"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.Messages"
    x:DataType="vm:MessageEditorViewModel"
    Title="{Binding Title}"
    Width="760"
    Height="760"
    MinWidth="480"
    MinHeight="560"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom" Spacing="10">
      <TextBlock
          AutomationProperties.LiveSetting="Assertive"
          Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
          IsVisible="{Binding HasError}"
          Text="{Binding ErrorMessage}"
          TextWrapping="Wrap" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding SaveCommand}" Content="{Binding SaveLabel}" IsDefault="True" />
        <Button Command="{Binding CancelCommand}" Content="{Binding CancelLabel}" IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{Binding Title, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
    <ScrollViewer Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding FoundCharactersLabel}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox
              Grid.Column="0"
              AutomationProperties.Name="{Binding SearchLabel}"
              PlaceholderText="{Binding SearchLabel}"
              Text="{Binding SearchText, Mode=TwoWay}">
            <TextBox.KeyBindings>
              <KeyBinding Command="{Binding SearchCommand}" Gesture="Enter" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="{Binding SearchButtonLabel}" />
        </Grid>
        <TextBlock IsVisible="{Binding HasSearchMessage}" Text="{Binding SearchMessage}" TextWrapping="Wrap" />
        <ListBox
            MaxHeight="140"
            AutomationProperties.Name="{Binding FoundCharactersLabel}"
            ItemsSource="{Binding FoundCharacters}"
            SelectedItem="{Binding FoundCharacter, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="events:CharacterChoice">
              <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Command="{Binding SetSenderCommand}" Content="{Binding SetSenderLabel}" />
          <Button Command="{Binding AddRecipientCommand}" Content="{Binding AddRecipientLabel}" />
        </WrapPanel>
        <TextBlock Classes="section" Text="{Binding SenderLabel}" />
        <TextBlock Text="{Binding SenderText}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="section" VerticalAlignment="Center" Text="{Binding RecipientsLabel}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding RecipientCountText}" />
        </Grid>
        <ListBox
            MaxHeight="140"
            AutomationProperties.Name="{Binding RecipientsLabel}"
            ItemsSource="{Binding Recipients}"
            SelectedItem="{Binding SelectedRecipient, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="events:CharacterChoice">
              <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Command="{Binding RemoveRecipientCommand}" Content="{Binding RemoveRecipientLabel}" />
        <TextBlock Text="{Binding MessageTitleLabel}" />
        <TextBox
            AutomationProperties.Name="{Binding MessageTitleLabel}"
            MaxLength="{Binding MaximumTitleLength}"
            Text="{Binding MessageTitle, Mode=TwoWay}" />
        <TextBlock Text="{Binding BodyLabel}" />
        <TextBox
            Height="220"
            AcceptsReturn="True"
            AutomationProperties.Name="{Binding BodyLabel}"
            MaxLength="{Binding MaximumBodyLength}"
            Text="{Binding Body, Mode=TwoWay}"
            TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
