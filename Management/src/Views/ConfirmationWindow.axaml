<Window
    x:Class="SciFiLarpNetwork.Management.Views.ConfirmationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels"
    x:DataType="vm:ConfirmationRequest"
    Title="{Binding Title}"
    Width="440"
    CanResize="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button
          Click="OnConfirm"
          Content="{Binding ConfirmLabel}" />
      <Button
          Click="OnCancel"
          Content="{Binding CancelLabel}"
          IsCancel="True"
          IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
