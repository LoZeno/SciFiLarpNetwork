<Window
    x:Class="SciFiLarpNetwork.Management.Views.Items.ItemCatalogEntryWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SciFiLarpNetwork.Management.Views.Converters"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.Items"
    x:DataType="vm:ItemCatalogEntryEditorViewModel"
    Title="{Binding Title}"
    Width="460"
    CanResize="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="10">
    <TextBlock Classes="heading" Text="{Binding Title, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
    <TextBlock Text="{Binding NameLabel}" />
    <TextBox
        AutomationProperties.Name="{Binding NameLabel}"
        MaxLength="64"
        Text="{Binding Name, Mode=TwoWay}" />
    <TextBlock
        AutomationProperties.LiveSetting="Assertive"
        Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
        IsVisible="{Binding HasError}"
        Text="{Binding ErrorMessage}"
        TextWrapping="Wrap" />
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button
          Command="{Binding SaveCommand}"
          Content="{Binding SaveLabel}"
          IsDefault="True" />
      <Button
          Command="{Binding CancelCommand}"
          Content="{Binding CancelLabel}"
          IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
