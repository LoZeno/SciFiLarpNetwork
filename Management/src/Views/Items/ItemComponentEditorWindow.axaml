<Window
    x:Class="SciFiLarpNetwork.Management.Views.Items.ItemComponentEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SciFiLarpNetwork.Management.Views.Converters"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.Items"
    x:DataType="vm:ItemComponentEditorViewModel"
    Title="{Binding Title}"
    Width="520"
    Height="520"
    MinWidth="400"
    MinHeight="300"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Classes="heading" Text="{Binding Title, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
      <TextBlock IsVisible="{Binding !IsAdding}" Text="{Binding ComponentName}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsAdding}">
        <TextBox
            Grid.Column="0"
            AutomationProperties.Name="{Binding SearchLabel}"
            PlaceholderText="{Binding SearchLabel}"
            Text="{Binding SearchText, Mode=TwoWay}">
          <TextBox.KeyBindings>
            <KeyBinding Command="{Binding SearchCommand}" Gesture="Enter" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Command="{Binding SearchCommand}" Content="{Binding SearchLabel}" />
      </Grid>
    </StackPanel>
    <StackPanel Margin="0,12,0,0" DockPanel.Dock="Bottom" Spacing="10">
      <TextBlock Text="{Binding QuantityLabel}" />
      <TextBox
          HorizontalAlignment="Left"
          MinWidth="120"
          AutomationProperties.Name="{Binding QuantityLabel}"
          MaxLength="2"
          Text="{Binding QuantityText, Mode=TwoWay}" />
      <TextBlock
          AutomationProperties.LiveSetting="Assertive"
          Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
          IsVisible="{Binding HasError}"
          Text="{Binding ErrorMessage}"
          TextWrapping="Wrap" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button
            Command="{Binding SaveCommand}"
            Content="{Binding SaveLabel}"
            IsDefault="True" />
        <Button
            Command="{Binding CancelCommand}"
            Content="{Binding CancelLabel}"
            IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <ListBox
        Margin="0,8,0,0"
        AutomationProperties.Name="{Binding ComponentLabel}"
        IsVisible="{Binding IsAdding}"
        ItemsSource="{Binding Choices}"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ItemChoice">
          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
