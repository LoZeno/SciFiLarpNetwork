<Window
    x:Class="SciFiLarpNetwork.Management.Views.Networks.NetworkEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SciFiLarpNetwork.Management.Views.Converters"
    xmlns:vm="using:SciFiLarpNetwork.Management.ViewModels.Networks"
    x:DataType="vm:NetworkEditorViewModel"
    Title="{Binding Title}"
    Width="600"
    Height="720"
    MinWidth="480"
    MinHeight="480"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel
        Margin="0,12,0,0"
        DockPanel.Dock="Bottom"
        Spacing="10">
      <TextBlock
          AutomationProperties.LiveSetting="Assertive"
          Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
          IsVisible="{Binding HasError}"
          Text="{Binding ErrorMessage}"
          TextWrapping="Wrap" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button
            Command="{Binding SaveCommand}"
            Content="{Binding SaveLabel}"
            IsDefault="True" />
        <Button
            Command="{Binding CancelCommand}"
            Content="{Binding CancelLabel}"
            IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Margin="0,0,12,0" Spacing="10">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Text="{Binding CodeLabel}" />
        <TextBox
            AutomationProperties.HelpText="{Binding CodeHelp}"
            AutomationProperties.Name="{Binding CodeLabel}"
            IsReadOnly="{Binding !IsCodeEditable}"
            MaxLength="32"
            Text="{Binding Code, Mode=TwoWay}" />
        <TextBlock
            FontSize="12"
            IsVisible="{Binding IsCodeEditable}"
            Text="{Binding CodeHelp}"
            TextWrapping="Wrap" />
        <TextBlock Text="{Binding NameLabel}" />
        <TextBox
            AutomationProperties.Name="{Binding NameLabel}"
            MaxLength="64"
            Text="{Binding Name, Mode=TwoWay}" />
        <TextBlock Text="{Binding DescriptionLabel}" />
        <TextBox
            Height="100"
            AcceptsReturn="True"
            AutomationProperties.Name="{Binding DescriptionLabel}"
            MaxLength="2000"
            Text="{Binding Description, Mode=TwoWay}"
            TextWrapping="Wrap" />
        <TextBlock Text="{Binding ThemeLabel}" />
        <ComboBox
            HorizontalAlignment="Left"
            MinWidth="200"
            AutomationProperties.Name="{Binding ThemeLabel}"
            ItemsSource="{Binding Themes}"
            SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NetworkThemeChoice">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock FontWeight="SemiBold" Text="{Binding BackgroundImageLabel}" />
        <TextBlock Text="{Binding ImageStatus}" TextWrapping="Wrap" />
        <Border
            MaxHeight="220"
            HorizontalAlignment="Left"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            IsVisible="{Binding HasPreviewImage}">
          <Image
              AutomationProperties.Name="{Binding BackgroundImageLabel}"
              Source="{Binding PreviewImage, Converter={x:Static converters:ImageBytesConverter.Instance}}"
              Stretch="Uniform" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding ChooseImageCommand}" Content="{Binding ChooseImageLabel}" />
          <Button Command="{Binding RemoveImageCommand}" Content="{Binding RemoveImageLabel}" />
        </StackPanel>
        <TextBlock FontSize="12" Text="{Binding ImageHelp}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
